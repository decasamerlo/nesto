#!/bin/sh
# Appends an inert "Refs: <reference>" trailer naming the meta-repo issue this
# commit belongs to, derived from the branch name.
#
# Fires only on a branch matching <type>/<issue-number>-<slug>. Any other
# branch — dependabot/*, main, a detached HEAD — is a no-op, which is how bot
# commits are exempted without special-casing an author.
#
# The same branch grammar is written out in docs/conventions/stacked-prs.md
# (Branch naming) and docs/conventions/commits.md (The Refs: trailer). All
# three change together.
#
# Install: mani run install-hooks --all --ignore-non-existing

set -eu

msg_file=$1

branch=$(git symbolic-ref --quiet --short HEAD) || exit 0

issue=$(printf '%s' "$branch" |
	sed -n -E 's#^(build|chore|docs|feat|fix)/([0-9]+)-[a-z0-9-]+$#\2#p')

[ -n "$issue" ] || exit 0

# A bare #N is repo-local: right in the meta-repo, a future wrong link in any
# other, so every other repo gets the qualified form.
#
# The test is against origin, and the patterns are anchored, so every shape
# that is not exactly the meta-repo — a sub-repo, a fork of either, a mirror
# path, a trailing slash — falls through to the qualified form. That is the
# safe direction to fall: qualified is never a wrong link, only redundant
# when it lands inside the meta-repo itself, while bare is reachable only
# from an origin that is the meta-repo. Rearranging remotes can cost
# verbosity here, never correctness.
meta=decasamerlo/nesto
case $(git config --get remote.origin.url || true) in
	*[/:]"$meta" | *[/:]"$meta".git) reference="#$issue" ;;
	*) reference="$meta#$issue" ;;
esac

git interpret-trailers --if-exists replace \
	--trailer "Refs: $reference" --in-place "$msg_file"

# On a message still to be written, git leaves line 1 free for the subject and
# interpret-trailers anchors the trailer straight onto line 2, where git reads
# it as part of that subject. Open a blank line to separate them. Has to run
# after interpret-trailers, which normalises leading blank lines away.
#
# This reads "line 1 is empty" as "no subject yet", which is true of the
# default template. Under a custom commit.template whose first line is a
# comment, interpret-trailers takes that comment for the subject and writes
# the trailer inside the template's comment block, and line 1 is not empty,
# so nothing below fires. Saving without typing then commits "Refs: <ref>"
# as the subject — the same end state as the empty-editor case, reached a
# different way.
if [ -z "$(sed -n 1p "$msg_file")" ]; then
	{ printf '\n'; cat "$msg_file"; } >"$msg_file.refs"
	mv "$msg_file.refs" "$msg_file"
fi
